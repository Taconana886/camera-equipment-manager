<view class="page">
  <view class="chat-header">
    <view class="bot-avatar">🤖</view>
    <view class="bot-info">
      <view class="bot-name">幸运团长 · AI 器材助手</view>
      <view class="bot-desc">查器材 · 推荐搭配 · 借用答疑</view>
    </view>
  </view>

  <scroll-view
    class="chat-body"
    scroll-y
    scroll-into-view="{{scrollToId}}"
    scroll-with-animation
  >
    <view wx:if="{{messages.length === 0}}" class="welcome">
      <view class="welcome-icon">📷</view>
      <view class="welcome-title">你好，我是幸运团长</view>
      <view class="welcome-text">问我任何器材问题，比如：</view>
    </view>

    <view
      wx:for="{{messages}}"
      wx:key="index"
      id="msg-{{index}}"
      class="msg-row {{item.role === 'user' ? 'msg-user' : 'msg-ai'}}"
    >
      <view wx:if="{{item.role === 'ai'}}" class="bubble-avatar">🤖</view>
      <view class="bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-ai'}}">{{item.content}}</view>
    </view>

    <view wx:if="{{sending}}" class="msg-row msg-ai">
      <view class="bubble-avatar">🤖</view>
      <view class="bubble bubble-ai typing">
        <view class="dot"></view><view class="dot"></view><view class="dot"></view>
      </view>
    </view>

    <view id="msg-bottom" class="bottom-space"></view>
  </scroll-view>

  <view class="quick-bar" wx:if="{{showQuick}}">
    <view
      wx:for="{{quickQuestions}}"
      wx:key="*this"
      class="quick-item"
      data-q="{{item}}"
      bindtap="tapQuick"
    >{{item}}</view>
  </view>

  <view class="input-bar">
    <input
      class="chat-input"
      value="{{inputValue}}"
      placeholder="问问器材，比如：有哪些镜头可以借？"
      placeholder-class="input-ph"
      confirm-type="send"
      disabled="{{sending}}"
      bindinput="onInput"
      bindconfirm="send"
    />
    <button class="send-btn" disabled="{{sending || !inputValue}}" bindtap="send">发送</button>
  </view>
</view>
