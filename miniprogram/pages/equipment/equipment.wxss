.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
}

.detail {
  padding: 24rpx;
}

.detail-img {
  width: 100%;
  height: 460rpx;
  border-radius: 16rpx;
  background: #f0f0f0;
}

.detail-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  color: #ccc;
}

.info-card {
  margin-top: 24rpx;
}

.name {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.status-tag {
  display: inline-block;
  font-size: 26rpx;
  padding: 8rpx 22rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.status-tag.available {
  background: #e8f7ee;
  color: #2e9e5b;
}

.status-tag.borrowed {
  background: #fdecec;
  color: #e05353;
}

.info-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-label {
  width: 160rpx;
  color: #999;
  font-size: 28rpx;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}

.borrow-info {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #fdf6f6;
  border-radius: 12rpx;
}

.borrow-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #e05353;
  margin-bottom: 12rpx;
}

.borrow-line {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

.actions {
  padding: 20rpx 24rpx;
}

.action-btn {
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
}

.btn-return {
  background: #fff;
  color: #e05353;
  border: 1rpx solid #e05353;
  border-radius: 12rpx;
}
