.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #2b2b2b;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #2b2b2b;
}

.list-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 4rpx;
  color: #999;
  font-size: 26rpx;
}

.add-btn {
  background: #2b2b2b;
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

.admin-card {
  display: flex;
  align-items: center;
}

.admin-card-main {
  flex: 1;
}

.admin-card-name {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.admin-card-meta {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.status-tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

.status-tag.available {
  background: #e8f7ee;
  color: #2e9e5b;
}

.status-tag.borrowed {
  background: #fdecec;
  color: #e05353;
}

.admin-card-ops {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.op {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  margin: 4rpx 0;
}

.op-edit {
  color: #2b2b2b;
  border: 1rpx solid #999;
}

.op-delete {
  color: #e05353;
  border: 1rpx solid #e05353;
}

.user-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.user-name {
  font-size: 30rpx;
  font-weight: bold;
}

.user-role {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.user-op {
  font-size: 24rpx;
  color: #2b2b2b;
  border: 1rpx solid #999;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

.record-card {
  padding: 24rpx;
}

.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-name {
  font-size: 30rpx;
  font-weight: bold;
}

.record-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

.record-status.borrowed {
  background: #fdecec;
  color: #e05353;
}

.record-status.returned {
  background: #e8f7ee;
  color: #2e9e5b;
}

.record-line {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

/* 表单弹层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.form-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  max-height: 90vh;
  overflow-y: auto;
  box-sizing: border-box;
}

.form-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.req {
  color: #e05353;
}

.input {
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  min-height: 120rpx;
}

.img-upload {
  display: flex;
  align-items: center;
}

.img-add {
  width: 160rpx;
  height: 160rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #bbb;
}

.preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.img-remove {
  margin-left: 24rpx;
  font-size: 26rpx;
  color: #e05353;
}

.form-btns {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.btn-cancel {
  flex: 1;
  background: #f5f5f5;
  color: #666;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.form-btns .btn-primary {
  flex: 1;
  border-radius: 12rpx;
  font-size: 30rpx;
}
