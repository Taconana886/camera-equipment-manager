page {
  background: #f5f5f5;
  font-size: 28rpx;
  color: #333;
}

.container {
  padding: 24rpx;
}

.btn-primary {
  background: #2b2b2b;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn-primary[disabled] {
  background: #ccc;
  color: #fff;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
